{
  "name": "meridian-product-web",
  "private": true,
  "dependencies": {
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "scripts": {
    "start": "node scripts/site.cjs start",
    "build": "node scripts/site.cjs build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watchAll=false --runInBand",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.cjs",
    "verify": "npm run check:format && npm run check:workflows && npm run test:unit && npm run build && npm run test:browser",
    "check:format": "prettier --check src scripts tests playwright.config.cjs public/index.html .github/workflows",
    "check:workflows": "node scripts/check-workflows.cjs",
    "test:webgpu": "node scripts/check-webgpu.cjs"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "prettier": "3.6.2",
    "react-scripts": "^5.0.1",
    "yaml": "2.9.1"
  },
  "homepage": ".",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1"
}
